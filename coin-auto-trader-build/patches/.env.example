# ============================================================
# 업비트 API 키 (https://upbit.com/mypage/open_api_management 에서 발급)
# ⚠️ 발급 시 "자산 출금" 권한은 절대 켜지 마세요. 조회+주문 권한만 켜세요.
# ⚠️ 이 파일을 .env 로 복사해서 실제 값을 채운 뒤, .env는 절대 깃허브 등에
#    올리지 마세요 (.gitignore에 이미 포함되어 있습니다).
# ============================================================
UPBIT_ACCESS_KEY=여기에_발급받은_ACCESS_KEY_입력
UPBIT_SECRET_KEY=여기에_발급받은_SECRET_KEY_입력

# ============================================================
# 자동매매 설정
# ============================================================
# 실제 주문을 낼지 여부. true 로 명시적으로 바꾸기 전까지는
# 무조건 모의매매(페이퍼 트레이딩)로만 동작합니다.
LIVE_TRADING=false

# 자동매매에 배정할 총 예산 (KRW). 이 금액과, 이 금액으로 봇이 직접 산
# 코인만 봇이 관리합니다. 기존에 보유 중이던 자산/수동으로 산 자산은
# 절대 건드리지 않습니다.
AUTO_TRADING_BUDGET_KRW=500000

# 종목을 봇이 알아서 고르게 할지 여부. true(기본값)면 아래 TARGET_MARKETS는
# 무시되고, 매 루프마다(정확히는 MARKET_RESCAN_INTERVAL_MIN 주기로) 전체
# 원화마켓을 스캔해서 "거래량 충분 + 최근 오르는 중(단, 너무 급등한 건 제외)"
# 코인 상위 TOP_N_MARKETS개를 후보로 삼습니다. 후보 안에서도 RSI+이동평균
# 전략이 실제 매수 타이밍을 다시 판단하므로, 후보라고 무조건 사는 건 아닙니다.
AUTO_SELECT_MARKETS=true

# 자동 선정 시, 동시에 감시할 후보 코인 개수
TOP_N_MARKETS=5

# 자동 선정 시, 최소 24시간 거래대금 필터 (원). 너무 적게 거래되는 코인은
# 시세 조작/급변동 위험이 커서 제외합니다.
MIN_24H_VOLUME_KRW=3000000000

# 자동 선정 시, 추격매수 방지 상한. 0.40 = 이미 24시간 동안 40% 넘게 오른
# 코인만 후보에서 제외합니다. 상승장에서는 대부분의 코인이 15~30% 씩
# 올라 있어서, 이 값을 낮게 두면 "다 오르는데 하나도 못 산다" 는 상황이
# 됩니다. 40%로 열어 두고 리스크는 아래 손절/트레일링으로 관리합니다.
# (파일 아래쪽 '어떤 종목을 노릴지' 항목과 같은 설정값입니다 - 중복 기재 X)

# 자동 선정 시, 전체 마켓을 다시 스캔하는 주기 (분)
MARKET_RESCAN_INTERVAL_MIN=60

# 자동 선정 대상에서 제외할 마켓 (스테이블코인 등, 콤마 구분)
EXCLUDE_MARKETS=KRW-USDT,KRW-USDC,KRW-DAI,KRW-TUSD,KRW-BUSD

# AUTO_SELECT_MARKETS=false 일 때만 사용되는, 직접 지정한 거래 대상 마켓
TARGET_MARKETS=KRW-BTC,KRW-ETH

# 한 번 매매 신호가 났을 때 총 예산 대비 한 종목에 넣을 최대 비중 (0~1)
MAX_POSITION_RATIO=0.3

# 하루 최대 손실 한도 (총 예산 대비 비율). 이 이상 잃으면 당일 자동매매 중지.
DAILY_LOSS_LIMIT_RATIO=0.05

# 매매 판단 루프 주기 (분 단위)
TRADE_LOOP_INTERVAL_MIN=5

# 리포트 생성 주기 (시간 단위). 기본 24 = 하루에 한 번.
REPORT_INTERVAL_HOURS=24

# 리포트를 매일 몇 시(KST, 0-23)에 만들지. REPORT_INTERVAL_HOURS=24일 때 사용.
REPORT_HOUR_KST=9

# ── 상승 패턴 학습 ─────────────────────────────────────────────
# 켜면 프로그램 시작 시 상승 패턴 표본이 목표치보다 적을 때
# 과거 캔들에서 자동으로 채운 뒤 학습합니다. 구동 중에도 계속 모읍니다.
PATTERN_LEARNING_ENABLED=true
# 모을 급등 사례 개수 (이보다 적으면 이 개수까지 과거에서 찾습니다)
PATTERN_TARGET_RISING=1000
# 몇 % 이상 오른 것을 '급등' 으로 볼지. 그 직전의 모습을 학습합니다.
PATTERN_RISE_THRESHOLD_PCT=15
# 몇 봉 안에 그만큼 오르면 급등으로 볼지 (15분봉 24개 = 6시간)
PATTERN_HORIZON_BARS=24
# 학습 결과를 매매에 쓰는 방식
#   signal = 급등 전조를 찾으면 직접 매수한다 (오르기 전에 미리 사는 방식, 권장)
#   filter = 기존 전략이 낸 매수를 검토만 한다
#   off    = 사용하지 않는다
PATTERN_ENTRY_MODE=signal
# 몇 시간마다 다시 학습할지
PATTERN_RETRAIN_HOURS=6
# 학습 결과를 실제 매수 판단에 반영할지 (기본 true).
# true 여도 모델이 '안 본 데이터' 검증에서 기준선을 넘지 못한 동안에는
# 적용을 보류합니다. 근거 없는 모델로 매수 기회를 날리지 않기 위해서입니다.
# 리포트 > 패턴 학습 탭에서 '반영 중 / 대기 중' 상태를 볼 수 있습니다.
USE_PATTERN_FILTER=true
# 위를 true 로 켰을 때 매수에 필요한 최소 상승 확률 (0.55 = 55%)
PATTERN_MIN_PROBA=0.55
# 구동 중 감시 종목이 이 비율 이상 오르면 '상승 기록'에 남깁니다 (%)
RISE_RECORD_THRESHOLD_PCT=1.0

# ── 매수 기회 늘리기 ──────────────────────────────────────
# 눌림목 매수: '오름세인데 잠깐 눌렸다 반등할 때' 를 추가 진입으로 씁니다.
# 골든크로스 하나만으로는 매수 기회가 너무 적습니다.
USE_PULLBACK_ENTRY=true
# 높일수록 기회가 많아집니다. 50=신중 / 55=권장 / 60=적극
PULLBACK_RSI_BELOW=55

# ── 손절/트레일링 빠른 점검 ────────────────────────────────
# 실거래 데이터에서 손절이 설정한 선을 넘어 체결된 사례가 있었습니다
# (기준 -5% 인데 -8.4%, 기준 -4% 인데 -5.9%). 주 판단 주기(보통 5분)
# 사이사이에 보유 종목의 현재가만 가볍게 확인해 더 빠르게 잡습니다.
# 0 으로 두면 끕니다(판단 주기에만 확인하던 예전 방식).
RISK_CHECK_INTERVAL_SEC=20

# ── 위험 관리 (손실이 이익보다 커지는 것을 막는 핵심 설정) ──────
# 진입가 대비 이만큼 내려가면 무조건 손절합니다. 0 = 손절 안 함(매우 위험).
STOP_LOSS_PCT=0.05
# 이익이 이만큼 난 뒤부터 '트레일링 스톱'이 작동합니다.
TRAIL_START_PCT=0.05
# 보유 중 최고가 대비 이만큼 밀리면 이익을 확정합니다.
# 이것이 '상한가 근처에서 파는' 역할을 합니다. 정확한 꼭대기는 아무도 못 맞히므로,
# 오르는 동안 계속 따라가다가 꺾이는 순간 파는 방식입니다.
TRAIL_DRAWDOWN_PCT=0.03
# 이 수익률에 닿으면 무조건 확정. 0 = 사용 안 함(트레일링에 맡김, 권장).
TAKE_PROFIT_PCT=0
# 이만큼의 판단 주기를 들고도 이익이 없으면 정리. 0 = 사용 안 함.
MAX_HOLD_BARS=0

# ── 어떤 종목을 노릴지 (24시간 등락률 구간) ──────────────────
# 하한. 0.15 로 두면 '24시간에 15% 이상 오른 종목만' 후보가 됩니다.
# 크게 오르는 종목을 노리는 대신, 이미 오른 것을 사는 위험도 함께 커집니다.
MIN_24H_CHANGE_RATE_FOR_ENTRY=0
# 상한(추격매수 방지, 기본 0.40). 하한을 올렸다면 이 값도 반드시 같이
# 올리세요. 하한 >= 상한이면 후보가 하나도 남지 않습니다.
MAX_24H_CHANGE_RATE_FOR_ENTRY=0.40

# ── 상승장 대응 (RSI 가 높아도 강한 추세면 매수) ────────────
# 강하게 오르는 코인은 RSI 가 오래 60 이상에 머뭅니다. 골든크로스/눌림목만
# 쓰면 이럴 때 매수 기회가 거의 사라집니다. 이 옵션을 켜면 RSI 가 높아도
# 상승 추세 자체가 강해지는 중이면 매수합니다.
USE_STRONG_TREND_ENTRY=true
# 이 RSI 를 넘으면(과열) 추세가 강해도 매수하지 않습니다.
# 과매수 매도 기준(RSI_SELL_ABOVE, 기본 75)보다 충분히 낮아야 합니다.
# 실거래에서 85로 뒀다가 RSI 76~80 구간에서 산 뒤 몇 분 만에 과매수로
# 되팔리는 손실이 하루 6~14회 반복된 적이 있습니다(예: PROM 3연속 손실).
STRONG_ENTRY_RSI_MAX=65

# ── 노이즈성 매매 방지 (실거래 손실 데이터 기반) ──────────────
# 눌림목 매수 판정 시 RSI 가 한 봉 만에 이보다 크게 뛰었으면 반등이 아니라
# 급등 스파이크의 꼭대기일 가능성이 높다고 보고 매수하지 않습니다.
# (실제 거래에서 RSI 53→85 처럼 한 봉에 급등한 뒤 되돌아와 손실로 이어진
# 사례가 있었습니다)
PULLBACK_MAX_RSI_JUMP=20
